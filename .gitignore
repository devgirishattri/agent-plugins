# Local dev-workspace launcher (machine-specific; not part of the marketplace).
# The .bak is the pre-migration launcher kept as the rollback copy — it can hold
# uncommitted local edits, so it must never be published.
# Anchored to the repo root on purpose: an unanchored "workspace.sh" matches at
# ANY depth and silently swallowed the session-workspace plugin's own CLI
# dispatcher (scripts/workspace.sh) and bootstrap shim (templates/workspace.sh)
# in both provider trees, publishing a plugin that could not run.
/workspace.sh
/workspace.sh.bak

# Local dev-workspace config (machine-specific; not part of the marketplace)
.agent-workspace/

# Local agent instruction files (machine/user-specific)
CLAUDE.md
AGENTS.md

# Local design and implementation plans
docs/
.tmp/
.agents/memory/

# Real project/client identifiers for the privacy sweep (machine-local; must
# never be committed to this public repo)
.privacy-denylist
