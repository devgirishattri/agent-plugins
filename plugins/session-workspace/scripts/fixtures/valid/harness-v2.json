{
  "schema_version": 2,
  "project": {
    "id": "harness-sample",
    "display_name": "Harness Sample",
    "root": "."
  },
  "runtimes": {
    "codex": {
      "program": "codex",
      "args": []
    }
  },
  "roles": {
    "master": {
      "runtime": "codex",
      "grants": [],
      "env_group": "dev"
    },
    "executor": {
      "runtime": "codex",
      "grants": ["messages", "scheduler", "contexts", "memory"],
      "env_group": "dev"
    },
    "reviewer": {
      "runtime": "codex",
      "grants": ["messages", "scheduler", "contexts"],
      "env_group": "dev"
    }
  },
  "stores": {
    "base": ".tmp",
    "pin": ["messages", "scheduler", "contexts"],
    "memory": {
      "mode": "shared",
      "root": ".agents/memory"
    }
  },
  "env": {
    "groups": {
      "dev": {
        "values": {},
        "pin_to_session": true
      }
    },
    "pane_name_aliases": []
  },
  "sessions": [
    {
      "id": "development",
      "name": "${PROJECT_ID}-development",
      "panes": [
        {
          "name": "${PROJECT_ID}-master",
          "role": "master",
          "cwd": "."
        },
        {
          "name": "${PROJECT_ID}-component-executor",
          "role": "executor",
          "cwd": "component-a"
        },
        {
          "name": "${PROJECT_ID}-component-reviewer",
          "role": "reviewer",
          "cwd": "component-a"
        }
      ]
    }
  ],
  "behavior": {
    "default_start_target": "development",
    "attach": "never",
    "stop_scope": "selected",
    "save_before_stop": true
  },
  "harness": {
    "enabled": true,
    "mode": "enforce",
    "profile": "strict-v1",
    "roles": {
      "orchestrator": "master",
      "executor": "executor",
      "reviewer": "reviewer"
    },
    "gates": {
      "plan_review_ttl_minutes": 60,
      "audit_ttl_minutes": 60
    }
  }
}
