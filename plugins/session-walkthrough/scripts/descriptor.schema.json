{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/devgirishattri/agent-plugins/session-walkthrough/descriptor.schema.json",
  "title": "session-walkthrough capture descriptor (schema_version 1)",
  "description": "Declares what one configured capture route can observe, record, or drive, what it needs, and how it leaves the host. A descriptor is a claim boundary, not proof of tested support: 'support' names the dependency tier (floor = platform tooling only), and a target counts as supported only when 'pilot.recorded' is true. Descriptors never contain executable shell strings; probe argv is a fixed, read-only availability check.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "platform", "transport", "target_kind", "capabilities", "recording", "prerequisites", "egress", "disallowed", "probe", "support", "notes"],
  "definitions": {
    "line": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000-\\u001f]*$" }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "platform": { "enum": ["web", "macos", "ios-simulator", "android-emulator", "electron"] },
    "transport": { "enum": ["mcp", "cli", "manual"] },
    "target_kind": { "enum": ["origin", "window", "app", "simulator", "emulator"] },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["screenshot", "record", "drive"],
      "properties": {
        "screenshot": { "type": "boolean" },
        "record": { "type": "boolean" },
        "drive": { "enum": ["none", "optional-driver", "manual"] }
      }
    },
    "recording": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kinds", "max_duration_seconds", "container", "codec", "audio"],
      "properties": {
        "kinds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["stills", "continuous", "frame-sampled"] } },
        "max_duration_seconds": { "type": "integer", "minimum": 1, "maximum": 180 },
        "container": { "oneOf": [ { "$ref": "#/definitions/line" }, { "type": "null" } ] },
        "codec": { "oneOf": [ { "$ref": "#/definitions/line" }, { "type": "null" } ] },
        "audio": { "enum": ["none", "optional", "unknown"] }
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "name", "detail"],
        "properties": {
          "kind": { "enum": ["command", "permission", "config", "device", "tool"] },
          "name": { "$ref": "#/definitions/line" },
          "detail": { "$ref": "#/definitions/line" }
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "opt_outs"],
      "properties": {
        "default": { "enum": ["none", "telemetry", "network", "unknown"] },
        "opt_outs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mechanism", "name", "value", "status"],
            "properties": {
              "mechanism": { "enum": ["flag", "env"] },
              "name": { "type": "string", "pattern": "^[A-Za-z0-9_.=-]{1,80}$" },
              "value": { "oneOf": [ { "$ref": "#/definitions/line" }, { "type": "null" } ] },
              "status": { "enum": ["researched", "verified"] }
            }
          }
        }
      }
    },
    "disallowed": { "type": "array", "items": { "$ref": "#/definitions/line" } },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "argv", "reads_only"],
      "properties": {
        "kind": { "enum": ["none", "command"] },
        "argv": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_./=-]{1,80}$" } },
        "reads_only": { "const": true }
      }
    },
    "support": { "enum": ["floor", "optional", "deferred", "unsupported"] },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded", "host", "detail"],
      "properties": {
        "recorded": { "type": "boolean" },
        "host": { "oneOf": [ { "$ref": "#/definitions/line" }, { "type": "null" } ] },
        "detail": { "$ref": "#/definitions/line" }
      }
    },
    "notes": { "type": "array", "items": { "$ref": "#/definitions/line" } }
  }
}
