{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "SESSION_CONTEXT_HOME=\"${SESSION_CONTEXT_HOME:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)/.tmp/contexts}\" bash \"$PLUGIN_ROOT/scripts/detect-snapshots.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/inject-recall.sh\" --session-start",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/inject-recall.sh\" --prompt",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$PLUGIN_ROOT/scripts/nudge-consolidate.sh\" --stop-json",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
